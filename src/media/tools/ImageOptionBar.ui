  </property>
  <property name="minimumSize">
   <size>
    <width>300</width>
    <height>36</height>
   </size>
  </property>
  <!-- P8.3.1 (2026-10-26): the stacked widget had no layout, so it kept
       whatever geometry the .ui gave it and never followed the bar's
       size. The options form inside then overflowed its host. Wrapping it
       in a layout makes it fill the bar, and the bar's own minimum width
       (300) keeps the dock from squeezing the form into clipped labels. -->
  <layout class="QVBoxLayout" name="verticalLayout">
   <property name="spacing">
    <number>0</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <widget class="QStackedWidget" name="stackedWidget">
     <widget class="QWidget" name="page0"/>
     <widget class="QWidget" name="page1"/>
     <widget class="QWidget" name="page2"/>
     <widget class="QWidget" name="page3"/>
     <widget class="QWidget" name="page4"/>
     <widget class="QWidget" name="page5"/>
