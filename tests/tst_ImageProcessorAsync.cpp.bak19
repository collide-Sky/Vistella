{
    auto engine = makeImageEditorEngine();
    cv::Mat src = makeMat(16, 16, cv::Scalar(100, 100, 100));
    auto future = ImageProcessorAsync::sharpen(engine.get(), src);
    QVERIFY(future.valid());
    auto r = future.get();
