{
    auto engine = makeImageEditorEngine();
    cv::Mat src = makeMat(16, 16, cv::Scalar(100, 100, 100));
    auto future = ImageProcessorAsync::exposure(engine.get(), src, 1.0);
    QVERIFY(future.valid());
    auto r = future.get();
    QVERIFY(r.isOk());
    // 100 * 2^1 = 200
    QVERIFY(r.value().at<cv::Vec3b>(8, 8)[0] >= 195);
}

