void tst_ImageProcessorAsync::test_engineContext_overload_edgeDetect()
{
    auto engine = makeImageEditorEngine();
    cv::Mat src = makeMat(16, 16, cv::Scalar(0, 0, 0));
    src.at<cv::Vec3b>(8, 8) = cv::Vec3b(255, 255, 255);
    auto future = ImageProcessorAsync::edgeDetect(engine.get(), src, 80, 180);
    QVERIFY(future.valid());
    auto r = future.get();
    QVERIFY(r.isOk());
    QVERIFY(!r.value().empty());
}

// P0-2.5 (2026-09-08): engine==nullptr fallback 同步 — 等价于
//   ImageWindow::setAsyncEnabled(false) 走 sync 路径的行为
//   验证: future 立即就绪 + Result 内容跟同步 ImageProcessor 一致
void tst_ImageProcessorAsync::test_engineContext_nullptr_fallback_sync()
{
    // engine == nullptr: 内部兜底走同步跑
    cv::Mat src = makeMat(16, 16, cv::Scalar(100, 100, 100));

    // 1) async facade (engine=null) 结果应跟 ImageProcessor 同步版一致
    auto asyncFuture = ImageProcessorAsync::gaussianBlur(nullptr, src, 5, 0);
    QVERIFY(asyncFuture.valid());
    // wait_for(0s) 立即返 ready — 验证走 sync 路径
    auto status = asyncFuture.wait_for(std::chrono::seconds(0));
    QVERIFY(status == std::future_status::ready);
    auto r = asyncFuture.get();
    QVERIFY(r.isOk());

    cv::Mat syncOut;
    ImageProcessor::gaussianBlur(src, syncOut, 5, 0);
    QCOMPARE(cv::sum(r.value())[0], cv::sum(syncOut)[0]);

    // 2) 其他 5 个 facade 同样行为
    auto sat = ImageProcessorAsync::saturation(nullptr, src, 0.5).get();
    QVERIFY(sat.isOk());
    auto hue = ImageProcessorAsync::hueShift(nullptr, src, 10.0).get();
    QVERIFY(hue.isOk());
    auto exp = ImageProcessorAsync::exposure(nullptr, src, 0.5).get();
    QVERIFY(exp.isOk());
    auto shrp = ImageProcessorAsync::sharpen(nullptr, src).get();
    QVERIFY(shrp.isOk());
    auto edge = ImageProcessorAsync::edgeDetect(nullptr, src, 80, 180).get();
    QVERIFY(edge.isOk());
}

QTEST_MAIN(tst_ImageProcessorAsync)
#include "tst_ImageProcessorAsync.moc"
