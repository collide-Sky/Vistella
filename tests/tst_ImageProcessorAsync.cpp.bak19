{
    auto engine = makeImageEditorEngine();
    cv::Mat src = makeMat(16, 16, cv::Scalar(50, 100, 200));
    auto future = ImageProcessorAsync::hueShift(engine.get(), src, 30.0);
    QVERIFY(future.valid());
    auto r = future.get();
    QVERIFY(r.isOk());
    QVERIFY(!r.value().empty());
}

